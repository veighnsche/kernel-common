# --- GENTOO POWERHOUSE: LXC / containers ---

# Namespaces (core container isolation)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Cgroups (resource control) + cgroup v2 (cgroup2 is auto-enabled with CONFIG_CGROUPS)
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

# Seccomp (container sandboxing)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# OverlayFS (container rootfs layering)
CONFIG_OVERLAY_FS=y

# Container networking (veth/bridge) + packet filtering
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y

# Nice-to-have netfilter matches (often used by tooling)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y

# Core pseudo-filesystems and IPC used by system containers
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# devpts is auto-enabled via CONFIG_UNIX98_PTYS
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
